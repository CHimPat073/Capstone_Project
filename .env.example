# Groq API Key (Recommended - ultra fast and generous free tier)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Name (Default: openai/gpt-oss-120b or llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI API Key (Optional fallback if not using Groq)
OPENAI_API_KEY=

# Note: If no API key is provided, the system automatically uses
# the built-in offline deterministic fallback mode for testing/demo.
